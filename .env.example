# Proveedor de IA: qwen (Ollama local) o gemini
AI_PROVIDER=qwen

# Ollama / Qwen local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Tiempo máximo de cada llamada al modelo, en segundos.
HTTP_TIMEOUT_SECONDS=2.5

# RabbitMQ. No commitear credenciales reales.
RABBITMQ_URL=amqps://user:password@host/vhost
RABBITMQ_ENABLED=true
RABBITMQ_EXCHANGE=taskit.events
RABBITMQ_DEAD_LETTER_EXCHANGE=taskit.dlx
RABBITMQ_AITA_QUEUE=aita.events
RABBITMQ_AITA_ROUTING_KEY=taskit.aita.events
RABBITMQ_SECURITY_ROUTING_KEY=taskit.security.events
RABBITMQ_PROFILE_ROUTING_KEY=taskit.profile.events
